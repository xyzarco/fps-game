{
  "name": "fps-game",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "playwright": "^1.65.0"
  },
  "dependencies": {
    "@recast-navigation/core": "0.44.0",
    "@recast-navigation/generators": "0.44.0",
    "@recast-navigation/three": "0.44.0",
    "@recast-navigation/wasm": "0.44.0"
  }
}